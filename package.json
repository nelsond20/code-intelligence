{
  "name": "code-intelligence",
  "version": "0.2.0",
  "description": "Local code retrieval, persistent work memory, and guarded execution plans for OpenCode",
  "type": "module",
  "private": true,
  "bin": {
    "code-intelligence": "dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "integrations",
    "README.md",
    "SECURITY.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli/main.js",
    "benchmark:prepare": "npm run build && node dist/scripts/benchmark.js prepare",
    "benchmark:evaluate": "npm run build && node dist/scripts/benchmark.js evaluate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
